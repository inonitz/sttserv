{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // Windows Debug Tests
        {
            "type": "lldb",
            "request": "launch",
            "name": "LLDB (Windows, Static)",
            "program": "${workspaceFolder}/build/debug/static/bin/sttserver_sandbox",
            "args": [
                "--model=dependencies\\local_models\\whisper-large-v3\\ggml-model.bin",
                "--fa",
                "--language=he",
                "--threads=1"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.follow-fork-mode child",
                // "breakpoint set --name main"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "LLDB (Windows, DLL)",
            "program": "${workspaceFolder}/build/debug/shared/bin/sttserver_sandbox",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "initCommands": [ "settings set target.process.follow-fork-mode child" ]
        },

        // Linux Debug Tests
        {
            "type": "lldb",
            "request": "launch",
            "name": "LLDB (Linux-x86_64-Static-Debug)",
            "program": "${workspaceFolder}/build/debug/static/bin/sttserver_sandbox",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "initCommands": [ "settings set target.process.follow-fork-mode child" ]
        },
        {
            // Run the lldb server manually ->
            // sudo ~/.vscode/extensions/vadimcn.vscode-lldb-1.12.1/lldb/bin/lldb-server platform --server --listen *:1234
            "type": "lldb",
            "request": "launch",
            "name": "LLDB (Linux-x86_64-Static-Debug) Remote",
            "program": "${workspaceFolder}/build/debug/static/bin/sttserver_sandbox",
            "args": [
                "--model=dependencies/models/ivrit_ai/whisper-large-v3-turbo/ggml-model.bin",
                "--fa",
                "--step=0",
                "--lang=he",
                "--threads=1"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "initCommands": [ 
                "settings set target.process.follow-fork-mode child",
                "platform select remote-linux",
                "platform connect connect://127.0.0.1:1234"
            ],

        }
    ]
}
